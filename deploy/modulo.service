[Unit]
Description=modulo
After=wotaskd.service
AssertPathExists=/opt/webobjects/log
AssertPathExists=/opt/webobjects/apps/modulo-runner.woa

[Service]
User=hugi
Group=hugi
ExecStart=/opt/webobjects/apps/modulo-runner.woa/modulo-runner -Dmodulo.wotaskd.host=10.0.1.40 -Dmodulo.wotaskd.port=1085 -Dmodulo.wotaskd.password=WOTASKD_PASSWORD_HASH -Dmodulo.proxy-port=80 -Dmodulo.domain-app.10.0.1.40=HomeControl -Dmodulo.domain-app.ljos.rebbi.is=HomeControl -WOPort 45678 -Xms64m -Xmx192m
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
