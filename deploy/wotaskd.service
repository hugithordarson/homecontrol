[Unit]
Description=wotaskd
After=network.target
AssertPathExists=/opt/webobjects/log
AssertPathExists=/opt/webobjects/apps/wotaskd.woa

[Service]
User=hugi
Group=hugi
ExecStart=/opt/webobjects/apps/wotaskd.woa/wotaskd -WOPort 1085 -DWODeploymentConfigurationDirectory=/opt/webobjects/conf -Xms32m -Xmx64m
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
